{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Flutter build runs locally; output in build/web'",
  "outputDirectory": "build/web",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/otp-proxy"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/otp-proxy.js": {
      "maxDuration": 30,
      "memory": 128
    }
  }
}